{
  "name": "dsh-web-login",
  "version": "1.3.0",
  "description": "Password gate for the DeepSeek Harness Web GUI: first-run password setup, remember-me sessions, brute-force lockout.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "page.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "audit-log",
    "authentication",
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "login",
    "password",
    "password-change",
    "remote-access",
    "reverse-proxy"
  ],
  "license": "MIT",
  "author": "liyang52520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyang52520/dsh-web-login.git"
  },
  "bugs": {
    "url": "https://github.com/liyang52520/dsh-web-login/issues"
  },
  "homepage": "https://github.com/liyang52520/dsh-web-login#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  }
}
